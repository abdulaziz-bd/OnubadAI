# OpenAI-compatible endpoint - used for text translate and Live conversation.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REALTIME_MODEL=

# Set to "none" for self-hosted Realtime servers (LocalAI, hf speech-to-speech) that skip ephemeral tokens; leave unset for OpenAI/Azure.
OPENAI_REALTIME_AUTH=
