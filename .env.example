# OpenAI API key, used server-side only.
#
# Powers two things:
#   - app/api/translate           text translation (chat completions)
#   - app/api/realtime/session    mints short-lived tokens for the Live
#                                  conversation screen's realtime session
#
# The browser never receives this key directly - only the ephemeral
# client_secret minted by /api/realtime/session. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
